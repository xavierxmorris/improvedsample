# Auto-detect text files and normalize line endings to LF
* text=auto

# Force shell scripts to always use LF line endings (critical for Linux/containers)
*.sh text eol=lf

# Other files that should always use LF
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.svelte text eol=lf
*.astro text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
